{
  "name": "textbook-tw-app",
  "private": true,
  "version": "0.1.0",
  "description": "textbook-tw 桌面介面",
  "license": "AGPL-3.0-or-later",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@fontsource/noto-serif-tc": "^5.3.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^39.8.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "wait-on": "^8.0.5"
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "esbuild@0.28.2": true
  }
}
